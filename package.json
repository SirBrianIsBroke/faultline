{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Release confidence tooling for browser, visual, and API regressions.",
  "bin": {
    "faultline": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run typecheck && vite build --config dashboard/vite.config.ts && tsc -p tsconfig.build.json",
    "demo": "tsx scripts/run-demo.ts",
    "demo:ci": "tsx scripts/run-demo.ts --no-sync",
    "dev": "vite --config dashboard/vite.config.ts --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "verify": "npm run lint && npm run test && npm run demo:ci && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "jiti": "^2.5.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
